# ============================================
# WRC AI Sales Platform — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file with real secrets.
# ============================================

# --- Database ---
DATABASE_URL=postgresql://wrc:wrc_dev_password@localhost:5432/wrc_sales?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- LINE Messaging API ---
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# --- AI Provider (Phase 3) ---
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# --- JWT Auth ---
JWT_SECRET=change_this_to_a_random_secret_at_least_32_chars
JWT_EXPIRES_IN=24h

# --- API Server ---
API_PORT=3000
API_HOST=0.0.0.0

# --- Web App ---
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Cloud Storage ---
# GCS_BUCKET_NAME=your_bucket_name
# GCS_KEY_FILE=path/to/service-account.json

# --- App ---
NODE_ENV=development
DEFAULT_TENANT_NAME=WRC
